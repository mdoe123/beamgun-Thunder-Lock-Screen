<Window x:Class="BeamgunApp.AuthorizeDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备授权"
        Height="240" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="检测到新USB设备插入，是否授权该设备？" FontSize="15" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" x:Name="DeviceNameText" FontSize="14" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="2" x:Name="DeviceIdText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="AuthorizeButton" Content="授权（加入白名单）" Width="160" Height="32" Margin="0,0,12,0"
                    Click="AuthorizeButton_Click" IsDefault="True"/>
            <Button x:Name="RejectButton" Content="不授权（弹出设备）" Width="140" Height="32"
                    Click="RejectButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="BeamgunApp.ManageWhitelistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理已授权设备"
        Height="340" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="HintText" Text="已授权设备列表：" Margin="0,0,0,8"/>
        <ListBox Grid.Row="1" x:Name="DeviceList" FontSize="12" Margin="0,0,0,12"
                 SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="DeleteButton" Content="删除选中设备" Width="120" Height="30" Margin="0,0,12,0"
                    Click="DeleteButton_Click"/>
            <Button Content="关闭" Width="80" Height="30" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
